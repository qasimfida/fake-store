---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import LandingPage from "../components/landing/LandingPage";
import { getProducts } from "../lib/fakestore";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/landing-shell.css";

const [{ entries: posts, cacheHint }, settings, products] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 3,
	}),
	getSiteSettings(),
	getProducts().catch(() => []),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const brand =
	!siteTitle || siteTitle === "My Blog" ? "Fake Store" : siteTitle;
const tagline =
	!siteTagline || siteTagline === "Thoughts on building for the web"
		? "A live shop powered by Fake Store API, with a journal beside it."
		: siteTagline;

const landingProducts = products.slice(0, 6).map((product) => ({
	id: product.id,
	title: product.title,
	price: product.price,
	image: product.image,
	category: product.category,
}));

const landingPosts = posts.map((post) => ({
	slug: post.id,
	title: post.data.title,
	excerpt: post.data.excerpt ?? null,
	date: post.data.publishedAt
		? post.data.publishedAt.toISOString()
		: null,
}));
---

<Base title={brand} description={tagline}>
	<LandingPage
		client:load
		brand={brand}
		tagline={tagline}
		products={landingProducts}
		posts={landingPosts}
	/>
</Base>
